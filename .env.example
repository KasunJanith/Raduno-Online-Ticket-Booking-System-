# Database
# For local development with PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/raduno26"
# 
# For Render.com (automatically provided):
# DATABASE_URL will be provided in the Render environment variables
DATABASE_URL="postgresql://user:password@localhost:5432/raduno26"

# Next.js public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin authentication secret (keep this secure!)
ADMIN_SECRET="your-secure-admin-secret-here"

# Cloudinary configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
